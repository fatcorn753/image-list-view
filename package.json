{
  "name": "image-list-view",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.4.2",
  "publisher": "fatcorn753",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fatcorn753/image-list-view.git"
  },
  "bugs": {
    "url": "https://github.com/fatcorn753/image-list-view/issues"
  },
  "homepage": "https://github.com/fatcorn753/image-list-view#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "imageListView.open",
        "title": "%command.open%",
        "category": "Image List View"
      },
      {
        "command": "imageListView.toggleClickToAdd",
        "title": "%command.toggleClickToAdd%",
        "category": "Image List View"
      }
    ],
    "configuration": {
      "title": "Image List View",
      "properties": {
        "imageListView.clickToAdd": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%config.clickToAdd%"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "imageListView.open",
          "when": "explorerResourceIsFolder || resourceExtname =~ /^\\.(png|jpe?g|gif|webp|bmp|svg|ico|avif)$/i",
          "group": "navigation@90"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/logic.test.js",
    "package": "npx --yes @vscode/vsce package"
  },
  "keywords": [
    "image",
    "viewer",
    "gallery",
    "compare",
    "preview",
    "graph",
    "plot"
  ]
}
