{
  "name": "image-list-view",
  "displayName": "Image List View",
  "description": "選んだ画像だけを 1 つのタブに縦または横で並べて表示する",
  "version": "0.3.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fatcorn753/image-list-view.git"
  },
  "bugs": {
    "url": "https://github.com/fatcorn753/image-list-view/issues"
  },
  "homepage": "https://github.com/fatcorn753/image-list-view#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "imageListView.open",
        "title": "画像を一覧表示",
        "category": "Image List View"
      },
      {
        "command": "imageListView.toggleClickToAdd",
        "title": "クリックで追加のオン・オフを切り替え",
        "category": "Image List View"
      }
    ],
    "configuration": {
      "title": "Image List View",
      "properties": {
        "imageListView.clickToAdd": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "画像をクリックやドラッグ&ドロップで開いたとき、1 枚ずつのプレビューではなく画像一覧に追加する。一覧を開いていなければ自動で開く。"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "imageListView.open",
          "when": "explorerResourceIsFolder || resourceExtname =~ /^\\.(png|jpe?g|gif|webp|bmp|svg|ico|avif)$/i",
          "group": "navigation@90"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/logic.test.js",
    "package": "npx --yes @vscode/vsce package"
  }
}
